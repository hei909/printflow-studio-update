; PrintFlow Studio — Windows installer (NSIS 3, Unicode)
; Designed by Mr. Haii (In Thanh Dat). Generated by build.py — edit installer.nsi.tpl, not the .nsi.
Unicode true
ManifestDPIAware true
SetCompressor /SOLID lzma

!include "MUI2.nsh"
!include "LogicLib.nsh"
!include "FileFunc.nsh"

!define APPNAME   "PrintFlow Studio"
!define VERSION   "@VERSION@"
!define PUBLISHER "Mr. Haii (In Thành Đạt)"
!define UNKEY     "Software\Microsoft\Windows\CurrentVersion\Uninstall\PrintFlowStudio"
!define UPDPAGE   "https://github.com/hei909/printflow-studio-update/releases"

Name "${APPNAME} ${VERSION}"
Caption "Cài đặt ${APPNAME} ${VERSION}"
OutFile "out\PrintFlowStudio_Setup_${VERSION}.exe"
InstallDir "$LOCALAPPDATA\Programs\PrintFlow Studio"
RequestExecutionLevel user
BrandingText "${APPNAME} ${VERSION}  ·  ${PUBLISHER}"
ShowInstDetails show
ShowUninstDetails show

VIProductVersion "@VERSION4@"
VIAddVersionKey "ProductName"     "${APPNAME}"
VIAddVersionKey "CompanyName"     "${PUBLISHER}"
VIAddVersionKey "FileDescription" "Bộ cài ${APPNAME} cho Adobe Illustrator"
VIAddVersionKey "FileVersion"     "${VERSION}"
VIAddVersionKey "ProductVersion"  "${VERSION}"
VIAddVersionKey "LegalCopyright"  "© ${PUBLISHER}"

!define MUI_ICON   "assets\printflow.ico"
!define MUI_UNICON "assets\printflow.ico"
!define MUI_WELCOMEFINISHPAGE_BITMAP   "assets\welcome.bmp"
!define MUI_UNWELCOMEFINISHPAGE_BITMAP "assets\welcome.bmp"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_RIGHT
!define MUI_HEADERIMAGE_BITMAP   "assets\header.bmp"
!define MUI_HEADERIMAGE_UNBITMAP "assets\header.bmp"
!define MUI_ABORTWARNING
!define MUI_ABORTWARNING_TEXT "Bạn có chắc muốn dừng cài đặt ${APPNAME}?"

Var EXT
Var OLDVER
Var OLDINFO

; ---------- pages ----------
!define MUI_WELCOMEPAGE_TITLE "Chào mừng đến với ${APPNAME} ${VERSION}"
!define MUI_WELCOMEPAGE_TEXT "Bộ công cụ tự động hoá chế bản cho Adobe Illustrator.$\r$\n$\r$\n$OLDINFO$\r$\nBộ cài sẽ gỡ bản cũ (nếu có) rồi cài bản mới cho tài khoản Windows này. Không cần quyền quản trị.$\r$\n$\r$\nNên LƯU FILE và ĐÓNG Illustrator trước khi tiếp tục.$\r$\n$\r$\nBấm Tiếp để tiếp tục."
!insertmacro MUI_PAGE_WELCOME

!define MUI_PAGE_HEADER_TEXT "Có gì mới trong bản ${VERSION}"
!define MUI_PAGE_HEADER_SUBTEXT "Các module và thay đổi trong bản này"
!define MUI_LICENSEPAGE_TEXT_TOP "Xem nhanh nội dung bản cài:"
!define MUI_LICENSEPAGE_TEXT_BOTTOM "Bấm Cài đặt để bắt đầu."
!define MUI_LICENSEPAGE_BUTTON "&Cài đặt"
!define MUI_PAGE_CUSTOMFUNCTION_LEAVE CheckIllustrator
!insertmacro MUI_PAGE_LICENSE "build\whatsnew.txt"

!insertmacro MUI_PAGE_INSTFILES

