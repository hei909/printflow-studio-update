; ---------- helpers ----------
Function .onInit
  System::Call 'kernel32::CreateMutex(p 0, i 0, t "PrintFlowStudioSetupMutex") p .r1 ?e'
  Pop $R0
  ${If} $R0 != 0
    MessageBox MB_OK|MB_ICONEXCLAMATION "Bộ cài ${APPNAME} đang chạy rồi."
    Abort
  ${EndIf}
  ReadRegStr $OLDVER HKCU "${UNKEY}" "DisplayVersion"
  StrCpy $OLDINFO ""
  ${If} $OLDVER != ""
    StrCpy $OLDINFO "Bản đang có trên máy: v$OLDVER  →  sẽ thay bằng v${VERSION}.$\r$\n"
  ${EndIf}
FunctionEnd

Function CheckIllustrator
  IfSilent done
  loop:
    nsExec::ExecToStack 'cmd /c tasklist /FI "IMAGENAME eq Illustrator.exe" /NH | find /I "Illustrator.exe"'
    Pop $0
    Pop $1
    ${If} $0 == 0
      MessageBox MB_ABORTRETRYIGNORE|MB_ICONEXCLAMATION "Adobe Illustrator đang mở.$\r$\n$\r$\n• Retry (Thử lại): sau khi đã LƯU FILE và ĐÓNG Illustrator.$\r$\n• Ignore (Bỏ qua): cài luôn, mở lại Illustrator sau khi cài.$\r$\n• Abort: quay lại." IDRETRY loop IDIGNORE done
      Abort
    ${EndIf}
  done:
FunctionEnd

; remove one old copy of a PrintFlow panel
!macro RemoveIfOurs DIR NAME
  StrCpy $R5 0
@NAMECHECKS@
  ${If} $R5 == 0
  ${AndIf} ${FileExists} "${DIR}\CSXS\manifest.xml"
    nsExec::ExecToStack 'cmd /c findstr /m /c:"vn.mrhai." /c:"com.mrhai.productionhub" /c:"com.hei.layoutphotobookgayphu" /c:"com.hei.cutlinestudio" /c:"com.local.textnumbercep" /c:"com.hei.taooccatcep" /c:"com.hei.hardcoveryearbook" /c:"com.hei.makecropmarkscep" "${DIR}\CSXS\manifest.xml"'
    Pop $R6
    Pop $R7
    ${If} $R6 == 0
      StrCpy $R5 1
    ${EndIf}
  ${EndIf}
  ${If} $R5 == 1
    DetailPrint "Gỡ bản cũ: ${NAME}"
    RMDir /r "${DIR}"
  ${EndIf}
!macroend

; ---------- install ----------
Section "PrintFlow Studio" SecMain
  SectionIn RO
  SetShellVarContext current
  StrCpy $EXT "$APPDATA\Adobe\CEP\extensions"
  CreateDirectory "$EXT"

  DetailPrint "Cho phép panel chạy trong Illustrator (PlayerDebugMode)…"
  WriteRegStr HKCU "Software\Adobe\CSXS.9"  "PlayerDebugMode" "1"
  WriteRegStr HKCU "Software\Adobe\CSXS.10" "PlayerDebugMode" "1"
  WriteRegStr HKCU "Software\Adobe\CSXS.11" "PlayerDebugMode" "1"
  WriteRegStr HKCU "Software\Adobe\CSXS.12" "PlayerDebugMode" "1"
  WriteRegStr HKCU "Software\Adobe\CSXS.13" "PlayerDebugMode" "1"

  DetailPrint "Tìm và gỡ bản cũ…"
  FindFirst $R0 $R1 "$EXT\*"
  scan:
    StrCmp $R1 "" scanned
    StrCmp $R1 "." next
    StrCmp $R1 ".." next
    IfFileExists "$EXT\$R1\*.*" 0 next
    !insertmacro RemoveIfOurs "$EXT\$R1" "$R1"
  next:
    FindNext $R0 $R1
    Goto scan
  scanned:
  FindClose $R0

  DetailPrint "Cài các module mới…"
  SetOverwrite on
  SetOutPath "$EXT"
  File /r "src\extensions\*.*"

  DetailPrint "Xoá bộ nhớ tạm CEP…"
  RMDir /r "$TEMP\cep_cache"

  ; uninstaller + Programs entry
  SetOutPath "$INSTDIR"
  File "assets\printflow.ico"
  File "build\whatsnew.txt"
  WriteUninstaller "$INSTDIR\Uninstall.exe"
  CreateDirectory "$SMPROGRAMS\PrintFlow Studio"
  CreateShortcut "$SMPROGRAMS\PrintFlow Studio\Gỡ cài đặt PrintFlow Studio.lnk" "$INSTDIR\Uninstall.exe" "" "$INSTDIR\printflow.ico"
  WriteINIStr "$SMPROGRAMS\PrintFlow Studio\Trang cập nhật PrintFlow Studio.url" "InternetShortcut" "URL" "${UPDPAGE}"

  WriteRegStr   HKCU "${UNKEY}" "DisplayName"     "${APPNAME}"
  WriteRegStr   HKCU "${UNKEY}" "DisplayVersion"  "${VERSION}"
  WriteRegStr   HKCU "${UNKEY}" "Publisher"       "${PUBLISHER}"
  WriteRegStr   HKCU "${UNKEY}" "DisplayIcon"     "$INSTDIR\printflow.ico"
  WriteRegStr   HKCU "${UNKEY}" "InstallLocation" "$EXT"
  WriteRegStr   HKCU "${UNKEY}" "UninstallString" '"$INSTDIR\Uninstall.exe"'
  WriteRegStr   HKCU "${UNKEY}" "QuietUninstallString" '"$INSTDIR\Uninstall.exe" /S'
  WriteRegStr   HKCU "${UNKEY}" "URLInfoAbout"    "${UPDPAGE}"
  WriteRegStr   HKCU "${UNKEY}" "URLUpdateInfo"   "${UPDPAGE}"
  WriteRegStr   HKCU "${UNKEY}" "Comments"        "Prepress Automation Suite cho Adobe Illustrator"
  WriteRegDWORD HKCU "${UNKEY}" "NoModify" 1
  WriteRegDWORD HKCU "${UNKEY}" "NoRepair" 1
  WriteRegDWORD HKCU "${UNKEY}" "EstimatedSize" @SIZEKB@
SectionEnd

; ---------- uninstall ----------
Section "Uninstall"
  SetShellVarContext current
  StrCpy $EXT "$APPDATA\Adobe\CEP\extensions"
@UNREMOVES@
  RMDir /r "$TEMP\cep_cache"
  Delete "$SMPROGRAMS\PrintFlow Studio\*.*"
  RMDir "$SMPROGRAMS\PrintFlow Studio"
  Delete "$INSTDIR\printflow.ico"
  Delete "$INSTDIR\whatsnew.txt"
  Delete "$INSTDIR\Uninstall.exe"
  RMDir "$INSTDIR"
  DeleteRegKey HKCU "${UNKEY}"
SectionEnd
